@app.post("/api/tempo/store/refresh")
def api_tempo_store_refresh(req: dict):
    """刷新指定 Tempo 邮箱的最新邮件，返回 OTP 和正文片段。"""
    email = (req.get("email") or "").strip()
    app_token = (req.get("app_token") or "").strip()
    if not email:
        return {"ok": False, "error": "email 必填"}
    # 前端可能收到脱敏值 ***，从 settings 兜底
    if not app_token or app_token == "***":
        from .db import get_setting as _get_setting
        app_token = _get_setting("tempo_app_token", "").strip()
    if not app_token:
        return {"ok": False, "error": "app_token 未配置，请在邮箱配置中设置 Tempo App Token"} 
    import requests as _req
    try:
        r = _req.get(
            f"https://tempomails.com/api/messages/{app_token}/{email}",
            headers={"User-Agent": "Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 Chrome/124.0.0.0 Mobile Safari/537.36",
                     "Accept": "application/json"},
            timeout=15,
        )
        if r.status_code != 200:
            return {"ok": False, "error": f"HTTP {r.status_code}"}
        data = r.json()
        msgs = data.get("messages") or []
        out = []
        import re as _re
        import re
        from html.parser import HTMLParser as _HTMLParser

        class _HtmlText(_HTMLParser):
            """把 HTML 转成易读纯文本。"""
            def __init__(self):
                super().__init__(convert_charrefs=True)
                self.parts = []
                self.skip = 0  # style/script 深度
            def handle_starttag(self, tag, attrs):
                if tag in ("style", "script"):
                    self.skip += 1
                if tag in ("br", "p", "div", "tr", "li", "h1", "h2", "h3"):
                    self.parts.append("\n")
                elif tag in ("td", "th"):
                    self.parts.append(" | ")
            def handle_endtag(self, tag):
                if tag in ("style", "script") and self.skip > 0:
                    self.skip -= 1
                if tag in ("p", "div", "tr", "li", "h1", "h2", "h3"):
                    self.parts.append("\n")
            def handle_data(self, data):
                if self.skip == 0:
                    self.parts.append(data)
            def text(self):
                raw = "".join(self.parts)
                # 压缩连续空白，保留换行
                lines = [re.sub(r"[ \t]+", " ", ln).strip() for ln in raw.splitlines()]
                out = "\n".join(ln for ln in lines if ln)
                return out[:4000]

        for m in msgs:
            body = m.get("body") or m.get("text") or m.get("content") or m.get("html") or ""
            subject = m.get("subject") or ""
            from_addr = m.get("from_email") or m.get("from") or ""
            otp = None
            mm = _re.search(r'(\d{4,8})', body)
            if mm:
                otp = mm.group(1)
            # 转成纯文本
            if "<" in body and ">" in body:
                _h = _HtmlText()
                try:
                    _h.feed(body)
                    plain = _h.text()
                except Exception:
                    plain = body[:4000]
            else:
                plain = body[:4000]
            out.append({
                "id": m.get("id", ""),
                "from": from_addr,
                "subject": subject,
                "otp": otp,
                "preview": body[:200],
                "body": plain,
            })
        return {"ok": True, "messages": out}
    except Exception as e:
        return {"ok": False, "error": str(e)[:200]}


